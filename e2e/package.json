{
  "name": "eop-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end UI tests for the EoP threat modelling card game. See docs/adr/ADR-068-playwright-e2e-testing.md",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "browsers": "playwright install --with-deps",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
