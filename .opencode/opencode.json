{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/rules/*.md"],
  "mcp": {
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian==0.23.0"],
      "enabled": true,
      "environment": {
        "JIRA_URL": "{env:JIRA_URL}",
        "JIRA_USERNAME": "{env:JIRA_USERNAME}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "repos,issues,pull_requests,actions"
      },
      "oauth": false,
      "timeout": 15000
    },
    "graphify": {
      "type": "local",
      "command": ["tools/graphify/node_modules/.bin/graphify", "serve"],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "rm *": "ask",
      "rm .tmp/*": "allow",
      "rm -f .tmp/*": "allow",
      "rm -r .tmp/*": "allow",
      "rm -rf .tmp/*": "allow",
      "rm -fr .tmp/*": "allow",
      "rm -r .tmp": "allow",
      "rm -rf .tmp": "allow",
      "rm -fr .tmp": "allow",
      "chmod 777 *": "ask",
      "git push --force*": "ask",
      "git push -f *": "ask",
      "git reset --hard*": "ask",
      "git clean -fd*": "ask",
      "* | sh": "ask",
      "* | bash": "ask",
      "* | zsh": "ask",
      "curl * | *": "ask",
      "wget * | *": "ask",
      "bash -c *": "ask",
      "sh -c *": "ask",
      "zsh -c *": "ask",
      "*/tmp/*": "deny",
      "*/tmp": "deny",
      "*/tmp *": "deny",
      "*/var/folders/*": "deny",
      "*$TMPDIR*": "deny",
      "*mktemp*": "deny"
    },
    "atlassian_jira_*": "allow",
    "atlassian_jira_move_*": "deny",
    "github_*": "deny",
    "github_get_*": "allow",
    "github_list_*": "allow",
    "github_search_*": "allow",
    "github_issue_read": "allow",
    "github_pull_request_read": "allow",
    "github_actions_*": "allow",
    "github_*_write": "deny",
    "graphify_*": "deny",
    "graphify_first_hop_summary": "allow",
    "graphify_graph_stats": "allow",
    "graphify_query_graph": "allow",
    "graphify_get_node": "allow",
    "graphify_get_neighbors": "allow",
    "graphify_get_community": "allow",
    "graphify_god_nodes": "allow",
    "graphify_shortest_path": "allow",
    "graphify_review_delta": "allow",
    "graphify_review_analysis": "allow",
    "graphify_recommend_commits": "allow"
  },
  "model": "{env:MODEL_A}",
  "small_model": "{env:MODEL_D}",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "{env:AWS_REGION}"
      }
    }
  },
  "plugin": [
    "opencode-vibeguard@0.1.0",
    "@tarquinen/opencode-dcp@3.1.15",
    "opencode-supermemory@2.0.12",
    "@nick-vi/opencode-type-inject@1.5.2",
    "opencode-scheduler@1.3.0",
    ["opencode-goal-plugin@0.8.1", {
      "maxTurns": 48,
      "maxDurationMs": 4500000,
      "maxTokens": 650000,
      "minDelayMs": 1500,
      "noProgressTokenThreshold": 50,
      "noProgressTurnsBeforePause": 2,
      "noToolCallTurnsBeforePause": 2,
      "noContinueWhileChildrenActive": true,
      "persistState": true,
      "stateFilePath": ".opencode/goals/state.json",
      "completionAudit": true,
      "auditorOptions": {
        "timeoutMs": 120000,
        "failurePolicy": "reject"
      }
    }],
    "@tarquinen/opencode-smart-title@0.1.7"
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "tech-lead"
    }
  },
  "agent": {
    "expert-alex-xu": { "model": "{env:MODEL_A}" },
    "expert-uncle-bod": { "model": "{env:MODEL_A}" },
    "tech-lead": { "model": "{env:MODEL_A}" },
    "expert-dave-farley": { "model": "{env:MODEL_B}" },
    "expert-kent-beck": { "model": "{env:MODEL_B}" },
    "product-owner": { "model": "{env:MODEL_B}" },
    "tester-api": { "model": "{env:MODEL_B}" },
    "tester-unit-and-quality": { "model": "{env:MODEL_B}" },
    "db-designer": { "model": "{env:MODEL_C}" },
    "devops-engineer": { "model": "{env:MODEL_C}" },
    "performance-engineer": { "model": "{env:MODEL_C}" },
    "ui-builder": { "model": "{env:MODEL_E}" },
    "architecture-guardian": { "model": "{env:MODEL_F}" },
    "security-auditor": { "model": "{env:MODEL_F}" },
    "sonarqube-expert": { "model": "{env:MODEL_F}" },
    "dependency-vulnerability": { "model": "{env:MODEL_F}" },
    "code-reviewer": { "model": "{env:MODEL_G}" }
  }
}
