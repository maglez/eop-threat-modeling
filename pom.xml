<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>org.maglez</groupId>
    <artifactId>ElevationOfPrivilegeEoP</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <commons-text.version>1.15.0</commons-text.version>

        <!--
            CVE-driven overrides of versions the Spring Boot parent manages (EOP-89, ADR-050).

            Each of these raises a Boot-managed version to the nearest patch release that
            closes a CVE reported by `tools/supply-chain/scan-dependencies.sh`. They are NOT
            preferences, and they are not pins in the sense the other properties above are.
            They exist only because the parent's managed version was vulnerable on the day
            they were added:

              postgresql       42.7.11 -> 42.7.12  CVE-2026-54291 (HIGH) SCRAM-SHA-256 MITM
                                                   protection bypass. The only HIGH, and the
                                                   only directly-declared dependency of the nine.
              jackson-2-bom    2.21.4  -> 2.21.7   CVE-2026-54515, CVE-2026-59889,
                                                   GHSA-mhm7-754m-9p8w (all MEDIUM), then
                                                   CVE-2026-89407, CVE-2026-89425,
                                                   CVE-2026-68497, CVE-2026-91776,
                                                   CVE-2026-91777 (all HIGH). Jackson 2 is on
                                                   the compile tree only via
                                                   springdoc -> swagger-core-jakarta.
              jackson-bom      3.1.4   -> 3.1.7    CVE-2026-59889 (MEDIUM), then the same five
                                                   HIGH CVEs. This is Jackson 3
                                                   (`tools.jackson.*`), Boot 4's own JSON stack.
              log4j2           2.25.4  -> 2.25.5   CVE-2026-49844 (MEDIUM). Reached at depth 3
                                                   via log4j-to-slf4j; note the enforcer's
                                                   bannedDependencies covers `log4j:log4j`,
                                                   the 1.x coordinates, so it never saw this.
              tomcat           11.0.22 -> 11.0.25  CVE-2026-65182, CVE-2026-65905,
                                                   CVE-2026-68525 (all CRITICAL). Security
                                                   constraint bypass, DIGEST replay auth
                                                   bypass, FORM auth bypass. This one property
                                                   governs the whole org.apache.tomcat.embed
                                                   family (core, el, websocket), reached via
                                                   spring-boot-starter-web -> -starter-tomcat.
                                                   Two of the three are unreachable here, as
                                                   this app ships no authentication (ADR-015),
                                                   but that is an exploitability argument and
                                                   not grounds to allowlist a CRITICAL when the
                                                   patch release is published.

            DELETE an entry once the Boot parent's own managed version reaches or passes it.
            Left in place they stop being fixes and become a ceiling, holding a library back
            from whatever the parent has tested against. That is the same rot that
            `tools/supply-chain/accepted-cves.json` fails the build over. Check with
            `./mvnw help:effective-pom` after a parent bump; nothing automated catches this.
        -->
        <postgresql.version>42.7.12</postgresql.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <log4j2.version>2.25.5</log4j2.version>
        <tomcat.version>11.0.25</tomcat.version>

        <spotbugs.version>4.9.3.0</spotbugs.version>
        <jacoco.version>0.8.13</jacoco.version>
        <jacoco.min.instruction>0.80</jacoco.min.instruction>
        <jacoco.min.branch>0.70</jacoco.min.branch>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-text</artifactId>
                <version>${commons-text.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <!-- Spring Boot 4 moved LiquibaseAutoConfiguration out of the monolithic
             autoconfigure jar into this module. Without it liquibase-core sits on
             the classpath doing nothing and every spring.liquibase.* property is
             inert, which is exactly the state this project was in: the changelog
             was configured, enabled, and never read. Nothing failed, because an
             unread changelog and an empty one are indistinguishable until the
             first migration exists. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-liquibase</artifactId>
        </dependency>
        <!-- Stays `runtime`, and is excluded from the repackaged jar further down. Do not
             "harden" this to `test`: the default profile resolves org.h2.Driver, so every
             `./mvnw spring-boot:run` needs H2 on the run classpath, and ADR-012 makes that
             path a decision rather than an accident. The artifact is hardened instead of the
             scope, which also holds if somebody later widens this to `compile`. See ADR-047. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 split the test slices out of spring-boot-test-autoconfigure.
             MockMvc support, and with it @AutoConfigureMockMvc, now lives in its own
             module and is no longer pulled in by spring-boot-starter-test. Without it
             the API contract could only be tested by starting a real servlet container
             on a port, which is slower and proves less about the web layer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers, for running the Liquibase changelog against the engine production
             actually uses (EOP-164, ADR-056). Until this existed, `006-session-expiry.xml`'s
             PostgreSQL branch was verified by nothing: the H2 branch ran in CI and the
             PostgreSQL one only in production.

             Three coordinates that are easy to get wrong:

             1. Testcontainers 2.x RENAMED every module with a `testcontainers-` prefix. The
                familiar 1.x `org.testcontainers:postgresql` and `org.testcontainers:junit-jupiter`
                DO NOT EXIST at 2.0.5 and fail resolution outright. The Boot 4.1.0 parent manages
                `testcontainers.version` at 2.0.5, so these are deliberately version-less.
             2. `spring-boot-testcontainers` supplies @ServiceConnection, which is what lets a
                container hand its JDBC URL to a Spring context without an @ActiveProfiles. Tests
                here activate no profile at all (see configuration.md), so the PostgreSQL settings
                that live in application-prod.yml are passed as explicit test properties instead.
             3. The PostgreSQL JDBC driver is NOT repeated here. It is already declared above at
                `runtime` scope, which is on the test classpath. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- H2 is kept off the deployable artifact (EOP-34, ADR-047). h2-2.4.240.jar
                     carries 13 classes in org.h2.server.web, including JakartaWebServlet, and
                     until now they shipped inside BOOT-INF/lib of the jar that runs on EC2:
                     a full unauthenticated SQL console one reflective servlet registration
                     away, in an artifact that never needs H2 at all because every deployed
                     configuration runs the `prod` profile against PostgreSQL.

                     The exclusion is deliberately on the `repackage` EXECUTION rather than on
                     the plugin. `excludes` is inherited from AbstractDependencyFilterMojo,
                     which the `run` goal extends too, so a plugin-level <configuration> would
                     also strip H2 from `./mvnw spring-boot:run` and break local development on
                     the default profile, the exact regression this shape exists to avoid.
                     Keep it here; do not hoist it.

                     The id below must stay `repackage`. Maven merges an execution with an
                     inherited one BY ID, which is what layers this configuration onto the
                     Boot parent's own repackage execution and preserves its
                     <mainClass>${start-class}</mainClass>. Rename the id and you get a
                     SECOND execution instead: the inherited repackage still runs, without
                     the exclusion, and H2 returns to the artifact with a green build.

                     tools/artifact/assert-no-h2-in-jar.sh gates the result. Precisely: no
                     SUREFIRE test can, because surefire runs at `test`, which precedes
                     `package`. A failsafe IT could: failsafe binds after `package` and is
                     already available from the Boot parent. It was rejected only because
                     declaring it would make a seventh declared plugin. See ADR-047. -->
                <executions>
                    <execution>
                        <id>repackage</id>
                        <configuration>
                            <excludes>
                                <exclude>
                                    <groupId>com.h2database</groupId>
                                    <artifactId>h2</artifactId>
                                </exclude>
                            </excludes>
                        </configuration>
                     </execution>
                </executions>
            </plugin>
            <!--
                The SEVENTH declared plugin, and EOP-164 pays that cost deliberately. The
                PostgreSQL migration tests must run under "mvnw verify" but not under
                "mvnw test", and surefire alone cannot express that: both commands execute the
                "test" phase with identical surefire configuration, so no JUnit tag and no
                junit-platform.properties setting can make one run more tests than the other.
                Only a plugin bound to a later phase separates them. ADR-047 weighed seven
                declared plugins as a real cost; EOP-164's AC4 accepts it, and ADR-056 records
                why.

                Do NOT delete this declaration as redundant. It was deleted once during EOP-164
                because "mvnw help:effective-pom" appeared to show the Boot parent binding
                failsafe by itself. It does not. The parent supplies the unnamed execution
                through pluginManagement, and a pluginManagement entry materialises only when
                the plugin is also declared here, so the effective POM had been computed with
                this very declaration in place and the reading was circular. With it deleted,
                "mvnw clean verify" ran 1360 tests, zero integration tests, and still reported
                BUILD SUCCESS with every coverage check met. A green build that silently skips
                the whole integration suite is the failure mode this declaration prevents.

                No version and no configuration of our own: the parent's pluginManagement
                supplies both, along with the integration-test and verify goal bindings. JaCoCo
                needs no second prepare-agent because failsafe's argLine also defaults to
                ${argLine}, and the integration-test phase precedes verify, so integration
                coverage merges into target/jacoco.exec before jacoco:check reads it.

                What selects between the two suites is class naming alone, enforced by nothing:
                surefire's default includes are Test*, *Test, *Tests and *TestCase, so a *IT class
                is invisible to "mvnw test"; failsafe's are IT*, *IT and *ITCase. Renaming a
                migration IT to *Test silently moves it into the fast suite and points it at H2,
                which is the very gap EOP-164 closed. Keep the *IT suffix.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <violationSeverity>warning</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                </configuration>
                <executions>
                    <execution>
                        <id>validate-style</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              Javadoc gate (EOP-120). The two halves of "missing + malformed" are enforced by
              two different tools on purpose.

              This plugin owns MALFORMED only: doclint's accessibility, html, reference and
              syntax groups catch broken {@link} targets, bad markup and mis-written tags,
              which Checkstyle cannot see.

              The `missing` group is switched OFF here and owned by Checkstyle instead
              (MissingJavadocType / MissingJavadocMethod / JavadocMethod in checkstyle.xml,
              all pinned to scope=public). Reason: doclint ignores the -public visibility
              flag when looking for absent comments and demands one on every private field,
              which would mean documenting ~50 private fields on the domain exception classes
              that are not public API. Checkstyle can be scoped to public members; doclint
              cannot. Do NOT "fix" this by writing doclint=all. And do not try
              doclint=all/protected either: javadoc rejects access qualifiers on -Xdoclint
              outright ("Access qualifiers not permitted for -Xdoclint arguments"), because
              visibility is already set by its own -public/-protected flag.

              Two things a reader should know about this plugin, both established by
              measurement during EOP-120 rather than assumed.

              Supply chain: this plugin is NOT covered by tools/supply-chain/. That tooling
              audits the seven OpenCode npm plugins only, and there is no ENFORCED verification
              at the Maven layer. Maven's default policy compares a .sha1 and only warns, there
              is no maven.config so no strict-checksums, and maven-wrapper.properties carries
              no distributionSha256Sum, so a Maven plugin runs arbitrary code in the build JVM.
              The figures below come from parsing the effective pom, not from reading this file,
              and they are re-derived the same way rather than trusted: count the top-level
              <plugin> elements of `./mvnw -q help:effective-pom` (a regex over <artifactId>
              over-counts, because h2 sits inside spring-boot's <dependencies> and
              maven-project-info-reports-plugin recurs across report sets). An earlier revision
              of this comment said six declarations and FOURTEEN bound entries while the file
              held seven and fifteen, because it had gone on omitting maven-failsafe-plugin
              (EOP-151, 2026-09-04) - so re-measure before citing any figure here.
              We DECLARE seven plugins and this is one of them: spring-boot, failsafe,
              checkstyle, javadoc, spotbugs, jacoco, enforcer. Only FIVE of the seven carry a
              version element here; spring-boot-maven-plugin and maven-failsafe-plugin carry
              none and take theirs from the Boot parent, so do not write that all seven are
              pinned in this file. Liquibase is not one of the seven and
              never executes, but do not say it is unmanaged either: liquibase-maven-plugin sits
              in the effective pluginManagement, parent-managed with no lifecycle
              binding, and liquibase-core runs during tests as an application dependency, which
              is a different thing again. The layer is also much larger than the seven: the
              effective build/plugins binds FIFTEEN entries, among them maven-compiler-plugin
              and maven-surefire-plugin, which execute in the build JVM on exactly
              these terms, and the effective pluginManagement carries THIRTY-ONE entries, almost
              all from the Boot parent. So bumping the parent coordinates near the top of this
              file moves about thirty plugin versions in one line, and that, rather than the seven
              declarations, is the real uncovered surface. Accepted knowingly; moving a pin is a
              supply-chain change. Extending tools/supply-chain/ to the Maven layer means the
              fifteen bound entries plus the wrapper, and belongs behind its own ADR.

              Incremental runs, stated as what has actually been verified and no further.
              CI is always the cold path: .github/workflows/ci.yml checks out a fresh runner
              with no target/, so every merge is gated on a full analysis. Locally the goal is
              incremental and can log "Skipping javadoc generation, everything is up to date."
              Do NOT read that line, or the goal's mere presence in a warm log, as proof it
              re-analysed your edit. The plugin's staleness record
              (target/maven-javadoc-plugin-stale-data.txt) lists jars and SOME of the output
              directory's top-level files (23 of 29 when measured, and options and packages are
              specifically NOT among them) and contains no .java path at all, so editing a Javadoc
              comment inside a source file need not invalidate it. If you have changed only
              comments, run "./mvnw clean verify" before pushing.

              debug=true below is kept deliberately, on grounds narrower than it once claimed
              here. What it does is retain the invocation files javadoc.sh, options and packages
              instead of deleting them after generating, which makes the flags that actually
              reached the tool auditable and a failure diagnosable. That is the whole
              justification. It is NOT a fix for a known failure: a warm "./mvnw verify" was
              once observed failing with "Unable to compute stale date:
              .../target/reports/apidocs/options" on a correct tree, but a later controlled
              experiment with debug removed could not reproduce it in five attempts, including
              the exact recipe originally cited, so the earlier claim that removing this
              reinstates the failure was WRONG and is retracted. The staleness check both states and reads
              the @-prefixed argument files: @options and @packages appear as bare argument
              lines in the record AND their expanded contents follow, via Files.readAllLines.
              It does not stat them. The plugin also rewrites options at the START of each
              invocation, before the
              comparison, so a previous run having deleted it cannot break the next one. The
              original failure is recorded as observed and unexplained. One caveat if anyone
              ever publishes target/reports/apidocs: options and javadoc.sh are the only two files
              there carrying absolute local paths. options holds a full transitive dependency
              inventory with versions; javadoc.sh holds the JDK patch level, vendor and install
              prefix, which the generated HTML does not (it says only "Generated by javadoc
              (21)"). packages adds nothing the HTML already exposes. Nothing publishes any of
              it today: target/ is gitignored, CI uploads target/*.jar only, and the image
              copies the jar alone.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <show>public</show>
                    <doclint>all,-missing</doclint>
                    <failOnError>true</failOnError>
                    <failOnWarnings>true</failOnWarnings>
                    <quiet>true</quiet>
                    <notimestamp>true</notimestamp>
                    <debug>true</debug>
                </configuration>
                <executions>
                    <execution>
                        <id>verify-javadoc</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>javadoc-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                    <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>analyze-bugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.instruction}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-rules</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <dependencyConvergence/>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>log4j:log4j</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
